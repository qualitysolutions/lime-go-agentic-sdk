# Copy to .env (gitignored) and fill in the OAuth client issued for your integration.
# Never commit the real .env.

# Which instance to use. "staging" maps to https://agentic.staging.lime-go.com.
# There is no default on purpose. For any other instance set LIME_GO_BASE_URL.
LIME_GO_ENV=staging

LIME_GO_CLIENT_ID=
LIME_GO_CLIENT_SECRET=
# Optional: space-separated scopes to request (omit for the client's default).
# LIME_GO_SCOPES=companies:read deals:read deals:write changes:read

# Several instances in one file: environment-specific values win.
# LIME_GO_PROD_BASE_URL=
# LIME_GO_PROD_CLIENT_ID=
# LIME_GO_PROD_CLIENT_SECRET=
